{
    "name": "@wanderlust/workspace",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.27.0",
    "engines": {
        "node": "22.21.0",
        "pnpm": "10.27.0"
    },
    "scripts": {
        "dev": "pnpm web:dev",
        "build": "pnpm web:build",
        "web:dev": "pnpm --filter @wanderlust/frontend dev",
        "web:build": "pnpm --filter @wanderlust/frontend build",
        "lint:eslint": "eslint --flag v10_config_lookup_from_file .",
        "lint:eslint:fix": "eslint --flag v10_config_lookup_from_file --fix .",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:knip": "knip --max-issues 30",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "20.2.0",
        "@commitlint/config-conventional": "20.2.0",
        "@eslint/js": "9.39.3",
        "concurrently": "9.2.1",
        "eslint": "9.39.3",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-zod": "3.5.0",
        "husky": "9.1.7",
        "knip": "5.76.3",
        "lint-staged": "16.2.7",
        "prettier": "3.7.4",
        "prettier-plugin-organize-imports": "4.3.0",
        "typescript-eslint": "8.50.0",
        "validate-branch-name": "1.3.2"
    }
}
