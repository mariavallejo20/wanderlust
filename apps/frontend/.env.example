# Base URL for the REST API. Must match VITE_API_BASE_URL in .env.test so MSW
# handler patterns intercept requests correctly during integration tests.
VITE_API_BASE_URL=http://localhost:3000/api
VITE_USE_MSW=true
VITE_APP_STAGE=development
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
